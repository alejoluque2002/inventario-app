# Copia este archivo como .env (en la raíz del proyecto) y rellena tus valores.
# .env está en .gitignore: NUNCA lo subas al repositorio.

# --- Base de datos ---
DB_HOST=localhost
DB_NAME=inventario_db
DB_USER=inventario_user
DB_PASS=cambia_esta_contraseña

# --- Email (alertas de stock) ---
# Si MAIL_USER o MAIL_PASS están vacíos, las alertas por email se desactivan.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=Gestor de Inventario
# Destinatario de las alertas (si se deja vacío se usa MAIL_USER)
ALERT_EMAIL=
